# UClamp tunings
on boot
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 96
    write /proc/sys/kernel/sched_util_clamp_min 128
	
    # system-background
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.min 20
    write /dev/cpuctl/system-background/cpu.uclamp.max 40
    # foreground
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/foreground/cpu.uclamp.min 20
    write /dev/cpuctl/foreground/cpu.uclamp.max 60
    #write /dev/cpuctl/nnapi-hal/cpu.uclamp.latency_sensitive
    #write /dev/cpuctl/nnapi-hal/cpu.uclamp.min
    #write /dev/cpuctl/nnapi-hal/cpu.uclamp.max
    #write /dev/cpuctl/rt/cpu.uclamp.latency_sensitive
    #write /dev/cpuctl/rt/cpu.uclamp.min
    #write /dev/cpuctl/rt/cpu.uclamp.max
    #write /dev/cpuctl/foreground_window/cpu.uclamp.latency_sensitive
    #write /dev/cpuctl/foreground_window/cpu.uclamp.min
    #write /dev/cpuctl/foreground_window/cpu.uclamp.max
    # dex2oat
    write /dev/cpuctl/dex2oat/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/dex2oat/cpu.uclamp.min 20
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 40
    # camera
    write /dev/cpuctl/camera-daemon/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/camera-daemon/cpu.uclamp.min 40
    write /dev/cpuctl/camera-daemon/cpu.uclamp.max 80
    # system
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system/cpu.uclamp.min 20
    write /dev/cpuctl/system/cpu.uclamp.max 40
    # top-app
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/top-app/cpu.uclamp.min 20
    write /dev/cpuctl/top-app/cpu.uclamp.max 100
    # background
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/background/cpu.uclamp.min 20
    write /dev/cpuctl/background/cpu.uclamp.max 40
